{
  "description": "Codex SessionStart: transfer stamp + cheap reconcile of owned agents (setup is the installer); SessionEnd timeout 3s; optional stop-time Grok review gate; SubagentStop handoff nudge.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/session-lifecycle-hook.mjs\" SessionStart --host codex",
            "timeout": 30,
            "statusMessage": "Grok session capture"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/session-lifecycle-hook.mjs\" SessionEnd --host codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/stop-review-gate-hook.mjs\"",
            "timeout": 900,
            "statusMessage": "Grok stop-review gate"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/subagent-stop-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Grok handoff reminder"
          }
        ]
      }
    ]
  }
}
